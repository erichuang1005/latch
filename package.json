{
  "name": "latch-ui",
  "version": "0.1.0",
  "description": "A2UI components for agents that ask only when they must and confirm before they act.",
  "license": "MIT",
  "author": "Eric Huang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erichuang1005/latch.git"
  },
  "homepage": "https://github.com/erichuang1005/latch#readme",
  "bugs": {
    "url": "https://github.com/erichuang1005/latch/issues"
  },
  "keywords": [
    "a2ui",
    "agent",
    "components",
    "latch",
    "react"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/latch/index.js",
  "types": "./dist/esm/latch/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/latch/index.d.ts",
      "import": "./dist/esm/latch/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 43123",
    "build": "next build",
    "build:lib": "rm -rf dist && tsc -p tsconfig.lib.json && tsc-alias -p tsconfig.lib.json && tsup && tailwindcss -i src/latch/styles.css -o dist/styles.css --minify && cp src/latch/tokens.css dist/tokens.css",
    "prepack": "npm run build:lib",
    "start": "next start --hostname 127.0.0.1 --port 43123",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-slot": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/cli": "^4",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "next": "16.4.0",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsc-alias": "^1.8.16",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
